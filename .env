# Rename this file to  .env  and fill in at least one AI key.
# The app works without any keys but uses local template scripts + gradient backgrounds.

# ── AI Script Providers (Gemini + Groq — both FREE, no credit card) ───────────

# 1. Gemini — Google AI  ← RECOMMENDED (easiest to get)
#    Free tier: 1 500 requests/day · 15 RPM
#    Get key in 30 seconds: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# 2. Groq — Llama 3.3 70B (used as fallback when Gemini is unavailable)
#    Free tier: 14 400 requests/day · 500 RPM
#    Get key: https://console.groq.com → API Keys
GROQ_API_KEY=your-groq-key-here

# ── Video Backgrounds ──────────────────────────────────────────────────────────
# Pexels — real cinematic B-roll matched to your topic
# FREE key (instant, no credit card): https://www.pexels.com/api
PEXELS_API_KEY=your-pexels-key-here
